# Copie este arquivo para ".env" (ou rode: npm run configurar) e preencha.
# NUNCA envie o .env para o GitHub: ele já está no .gitignore.

# Endereço do banco no Neon (Dashboard do Neon > Connect > "Pooled connection").
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo que protege a sessão de login. Gere um texto aleatório longo
# (ex.: openssl rand -base64 32).
AUTH_SECRET=

# Usuário inicial: usados só no PRIMEIRO login, quando o banco ainda não tem usuário.
# Depois do primeiro acesso, a senha fica guardada no banco (como hash) e GUI_SENHA pode ser apagada.
GUI_EMAIL=voce@exemplo.com
GUI_SENHA=
GUI_NOME=Seu Nome
